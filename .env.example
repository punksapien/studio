# Nobridge environment variables — copy to .env.local and fill in.
#   macOS/Linux:  cp .env.example .env.local   (or run ./setup-env.sh)
#   Windows (PowerShell):  Copy-Item .env.example .env.local
# NEVER commit .env.local or any real secret values.

# --- Required ---

# Local dev: http://127.0.0.1:54321 (printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep out of client code and out of git.
SUPABASE_SERVICE_ROLE_KEY=

# App origin, e.g. http://localhost:9002 for local dev
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Random 32+ char strings (setup-env.sh generates these on macOS/Linux;
# on Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
NEXTAUTH_SECRET=

# --- Email (production; local dev uses Inbucket at http://localhost:54324) ---
RESEND_API_KEY=

# --- Optional / feature-specific ---
SUPABASE_JWT_SECRET=
BLOG_API_KEY=
# Shared secret for the Vercel cron hitting /api/cleanup/process
CLEANUP_SERVICE_TOKEN=
VERIFICATION_REQUEST_TIMEOUT=
NEXT_PUBLIC_SITE_URL=
# Feature flag: when 'true', unverified buyers are locked to Onboarding/Settings/Profile and blocked from inquiries (buyer verification gate).
NEXT_PUBLIC_BUYER_VERIFICATION_LOCKDOWN=false

# --- Used only by scripts/ (production data tooling) ---
REMOTE_SUPABASE_URL=
REMOTE_SUPABASE_SERVICE_KEY=

# --- CRM + Google Chat sign-up sync (all optional; feature no-ops if unset) ---
# When a buyer/seller verifies their email, a lead is pushed into the Twenty CRM
# (source = "Sign Ups") and a card is posted to a Google Chat space. See src/lib/crm-sync.ts.
# Twenty CRM base URL (defaults to https://crm.nobridge.co if unset).
TWENTY_API_URL=
# Long-lived Twenty API-key JWT (minted from the CRM APP_SECRET; sensitive).
TWENTY_API_TOKEN=
# Google Chat incoming-webhook URLs — sign-ups route by side (sensitive).
# Buyers post to the buy-side space; sellers to the sell-side space.
GOOGLE_CHAT_BUYSIDE_WEBHOOK_URL=
GOOGLE_CHAT_SELLSIDE_WEBHOOK_URL=
# Google Chat space for M&A assessment popup leads (sensitive).
GOOGLE_CHAT_LEADS_WEBHOOK_URL=
# Optional: assign new sign-up opportunities to this Twenty workspace-member id.
# Leave unset to create them unassigned (triaged via the Chat notification).
TWENTY_DEFAULT_OWNER_ID=
