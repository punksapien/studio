# Normalize line endings: everyone commits LF, regardless of OS.
# Git handles working-tree conversion automatically — do NOT fight this
# with core.autocrlf overrides; the repo is the source of truth.
* text=auto eol=lf

# Windows scripts that genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
